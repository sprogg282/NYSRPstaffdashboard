rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // AUTHENTICATION & ROLE HELPERS
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function getUserRank() {
      return hasUserDoc() && ('rank' in getUserData())
        ? getUserData().rank
        : null;
    }

    function isNotificationOwner() {
      return hasUserDoc()
        && ('rank' in getUserData())
        && getUserRank() is string
        && getUserRank().trim().lower() == 'owner';
    }

    // ==========================================
    // OWNER / CO-OWNER
    // ==========================================

    function isOwnerOrCoOwner() {
      return isAuthenticated()
        && hasUserDoc()
        && ('rank' in getUserData())
        && getUserRank() in [
          'owner',
          'co owner',
          'Owner',
          'Co Owner'
        ];
    }

    // ==========================================
    // MANAGEMENT+
    // ==========================================

    function isManagementOrHigher() {
      return isAuthenticated()
        && hasUserDoc()
        && ('rank' in getUserData())
        && getUserRank() in [
          'owner',
          'co owner',
          'director',
          'management',
          'Owner',
          'Co Owner',
          'Director',
          'Management'
        ];
    }

    // ==========================================
    // BAN BOLO RESOLUTION
    // ==========================================
    //
    // Allows ONLY Owner, Co Owner, Director and
    // Management to resolve an existing Ban BOLO.
    //
    // This does NOT give these ranks unrestricted
    // log update permissions.
    //
    // Lower-ranking staff can still CREATE/SUBMIT
    // BOLO logs through the existing create rule.
    //
    // ==========================================

    function isBoloResolutionUpdate() {
      return isAuthenticated()
        && hasUserDoc()
        && ('rank' in getUserData())
        && getUserRank() in [
          'owner',
          'co owner',
          'director',
          'management',
          'Owner',
          'Co Owner',
          'Director',
          'Management'
        ]
        && resource.data.type == 'bolo'
        && resource.data.boloStatus in [
          'pending',
          'active'
        ]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'boloStatus',
          'approvedBy',
          'approvedAt',
          'approvalReason',
          'finalOutcome'
        ]);
    }

    // ==========================================
    // LOA REVIEWERS
    // ==========================================

    function canManageLoa() {
      return isAuthenticated()
        && hasUserDoc()
        && ('rank' in getUserData())
        && getUserRank() in [
          'owner',
          'co owner',
          'director',
          'management',
          'internal affairs',
          'Owner',
          'Co Owner',
          'Director',
          'Management',
          'Internal Affairs'
        ];
    }

    // ==========================================
    // 1. USERS COLLECTION
    // ==========================================

    match /users/{userId} {

      allow read: if isAuthenticated();

      allow create: if isAuthenticated() && (
        isOwnerOrCoOwner()
        ||
        (
          request.auth.uid == userId
          &&
          (
            !('rank' in request.resource.data)
            ||
            request.resource.data.rank in [
              'staff',
              'moderator',
              'Staff',
              'Moderator'
            ]
          )
        )
      );

      allow update: if isAuthenticated() && (
        isOwnerOrCoOwner()
        ||
        (
          request.auth.uid == userId
          &&
          (
            !('rank' in request.resource.data)
            ||
            request.resource.data.rank == resource.data.rank
          )
          &&
          (
            !('email' in request.resource.data)
            ||
            request.resource.data.email == resource.data.email
          )
          &&
          (
            !('createdAt' in request.resource.data)
            ||
            request.resource.data.createdAt == resource.data.createdAt
          )
        )
      );

      allow delete: if isOwnerOrCoOwner();

      match /notifications/{notificationId} {
        allow read: if isAuthenticated()
          && resource.data.recipientUid == userId
          && (
            request.auth.uid == userId
            || isNotificationOwner()
          );

        allow create: if isManagementOrHigher()
          && exists(/databases/$(database)/documents/users/$(userId))
          && request.resource.data.keys().hasAll([
            'recipientUid', 'title', 'message', 'type', 'createdAt', 'read',
            'available', 'priority', 'destination', 'creatorUid', 'creatorName',
            'creatorRank'
          ])
          && request.resource.data.keys().hasOnly([
            'recipientUid', 'title', 'message', 'type', 'createdAt', 'read',
            'available', 'priority', 'destination', 'creatorUid', 'creatorName',
            'creatorRank'
          ])
          && request.resource.data.recipientUid == userId
          && request.resource.data.creatorUid == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 1000
          && request.resource.data.type in ['staff_notification', 'staff_update']
          && request.resource.data.createdAt is timestamp
          && request.resource.data.read == false
          && request.resource.data.available is bool
          && request.resource.data.priority in ['normal', 'important', 'urgent']
          && request.resource.data.destination is string
          && request.resource.data.creatorName is string
          && request.resource.data.creatorRank is string;

        allow update: if isAuthenticated()
          && request.auth.uid == userId
          && resource.data.recipientUid == userId
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
              && resource.data.read == false
              && request.resource.data.read == true
              && request.resource.data.readAt is timestamp
            ) ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['available'])
              && resource.data.available == false
              && request.resource.data.available == true
            )
          );

        allow delete: if isAuthenticated()
          && resource.data.recipientUid == userId
          && (
            request.auth.uid == userId
            || isNotificationOwner()
          );
      }
    }

    // ==========================================
    // 2. ACTION & AUDIT LOGS
    // ==========================================

    match /logs/{logId} {

      // Authenticated users can read logs.
      allow read: if isAuthenticated();

      // Keep existing BOLO/log submission behaviour.
      // Lower-ranking staff can still submit BOLOs.
      allow create: if isAuthenticated();

      // Owner/Co-Owner retain full log update permission.
      //
      // Director/Management can ONLY update an existing
      // BOLO through the restricted resolution rule above.
      allow update: if isOwnerOrCoOwner()
        || isBoloResolutionUpdate();

      // Only Owner/Co-Owner can delete logs.
      allow delete: if isOwnerOrCoOwner();
    }

    // ==========================================
    // 3. MESSAGE PRESETS
    // ==========================================

    match /presets/{presetId} {

      allow read: if isAuthenticated();

      allow create, update, delete: if isManagementOrHigher();
    }

    // ==========================================
    // 4. MANAGE REASONS
    // ==========================================

    match /reasons/{reasonId} {

      allow read: if isAuthenticated();

      allow create, update, delete: if isOwnerOrCoOwner();
    }

    // ==========================================
    // 5. LOA REQUESTS
    // ==========================================

    match /loaRequests/{requestId} {

      allow read: if isAuthenticated();

      allow create: if isAuthenticated() && (
        request.resource.data.staffUid == request.auth.uid
        &&
        request.resource.data.status == "pending"
        &&
        (
          !('reviewerUid' in request.resource.data)
          ||
          request.resource.data.reviewerUid == ""
        )
        &&
        (
          !('reviewedBy' in request.resource.data)
          ||
          request.resource.data.reviewedBy == ""
        )
      );

      allow update: if isAuthenticated() && (
        canManageLoa()
        ||
        (
          resource.data.staffUid == request.auth.uid
          &&
          resource.data.status == "pending"
          &&
          request.resource.data.staffUid == resource.data.staffUid
          &&
          request.resource.data.status == "pending"
          &&
          (
            !('reviewerUid' in request.resource.data)
            ||
            request.resource.data.reviewerUid == ""
          )
          &&
          (
            !('reviewedBy' in request.resource.data)
            ||
            request.resource.data.reviewedBy == ""
          )
        )
      );

      allow delete: if isAuthenticated() && (
        isOwnerOrCoOwner()
        ||
        (
          resource.data.staffUid == request.auth.uid
          &&
          resource.data.status == "pending"
        )
      );
    }

    // ==========================================
    // 6. NYSRP STAFF SHIFTS
    // ==========================================

    match /shifts/{shiftId} {

      allow read: if isAuthenticated();

      allow create: if isAuthenticated() && (
        request.resource.data.staffUid == request.auth.uid
        &&
        request.resource.data.status in [
          'active',
          'break'
        ]
      );

      allow update: if isAuthenticated() && (
        isManagementOrHigher()
        ||
        (
          resource.data.staffUid == request.auth.uid
          &&
          request.resource.data.staffUid == resource.data.staffUid
          &&
          request.resource.data.staffRank == resource.data.staffRank
          &&
          request.resource.data.startTime == resource.data.startTime
          &&
          request.resource.data.createdAt == resource.data.createdAt
          &&
          request.resource.data.status in [
            'active',
            'break',
            'completed'
          ]
        )
      );

      allow delete: if isOwnerOrCoOwner();
    }

    // ==========================================
    // ADDITIONAL ER:LC COLLECTIONS
    // ==========================================

    match /erlc_player_sessions/{sessionId} {
      allow read, write: if isAuthenticated();
      allow delete: if isOwnerOrCoOwner();
    }

    match /erlc_kills/{killId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isOwnerOrCoOwner();
    }

    match /erlc_commands/{commandId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isOwnerOrCoOwner();
    }

    match /erlc_events/{eventId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isOwnerOrCoOwner();
    }

    match /erlc_mod_calls/{callId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isOwnerOrCoOwner();
    }

    match /erlc_off_duty_commands/{alertId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isOwnerOrCoOwner();
    }
  }
}
