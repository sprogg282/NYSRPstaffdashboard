rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // PROTECTED OWNER ACCOUNT
    // ==========================================
    // The Owner profile cannot be demoted or deleted by staff management writes
    function isProtectedOwnerAccount(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return exists(userPath)
        && get(userPath).data.email == 'sprog28@hotmail.com';
    }

    // ==========================================
    // AUTHENTICATION & ROLE HELPERS
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRank() {
      return hasUserDoc() && ('rank' in getUserData()) ? getUserData().rank : 'Junior Moderator';
    }

    function isRank(rank, values) {
      return rank in values;
    }

    function isJuniorModeratorRank(rank) {
      return isRank(rank, ['Junior Moderator', 'junior moderator', 'staff', 'Staff']);
    }

    function isModeratorRank(rank) {
      return isRank(rank, ['Moderator', 'moderator', 'mod']);
    }

    function isJuniorAdministratorRank(rank) {
      return isRank(rank, ['Junior Administrator', 'junior administrator']);
    }

    function isAdministratorRank(rank) {
      return isRank(rank, ['Administrator', 'administrator', 'admin']);
    }

    function isOwnerOrCoOwnerRank(rank) {
      return isRank(rank, ['Owner', 'Co Owner', 'owner', 'co owner', 'co-owner']);
    }

    function isManagementOrHigherRank(rank) {
      return isRank(rank, [
        'Owner', 'Co Owner', 'Director', 'Management',
        'owner', 'co owner', 'co-owner', 'director', 'management'
      ]);
    }

    function canHandleBoloRank(rank) {
      return isRank(rank, [
        'Owner', 'Co Owner', 'Director', 'Management',
        'owner', 'co owner', 'co-owner', 'director', 'management'
      ]);
    }

    function canManageLoaRank(rank) {
      return isRank(rank, [
        'Owner', 'Co Owner', 'Director', 'Management', 'Internal Affairs',
        'owner', 'co owner', 'co-owner', 'director', 'management', 'internal affairs'
      ]);
    }

    // Owner and Co-Owner (Ranks 8 & 7)
    function isOwnerOrCoOwner() {
      return isAuthenticated() && hasUserDoc() && isOwnerOrCoOwnerRank(getUserRank());
    }

    // Management, Director, Co-Owner, Owner (Ranks 5, 6, 7, 8)
    function isManagementOrHigher() {
      return isAuthenticated() && hasUserDoc() && isManagementOrHigherRank(getUserRank());
    }

    // LOA Reviewers: Internal Affairs, Management, Director, Co-Owner, Owner (Ranks 4, 5, 6, 7, 8)
    function canManageLoa() {
      return isAuthenticated() && hasUserDoc() && canManageLoaRank(getUserRank());
    }

    function isAllowedCanonicalRank(rank) {
      return rank in [
        'Junior Moderator', 'Moderator', 'Junior Administrator', 'Administrator',
        'Staff Supervisor', 'Internal Affairs', 'Management', 'Director', 'Co Owner', 'Owner'
      ];
    }

    // ==========================================
    // 1. USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated();

      // Profile creation: Users can create their own initial profile, or Owners can create accounts
      allow create: if isAuthenticated() && (
        isOwnerOrCoOwner() ||
        (request.auth.uid == userId && (
          !('rank' in request.resource.data) ||
          isJuniorModeratorRank(request.resource.data.rank) ||
          isModeratorRank(request.resource.data.rank)
        ))
      );

      // Updates: Owners have full edit access; regular users CANNOT alter rank, email, or createdAt
      // PROTECTION: The protected Owner account's rank field cannot be changed by anyone (including Owners)
      allow update: if isAuthenticated() && (
        (isOwnerOrCoOwner() && !isProtectedOwnerAccount(userId)) ||
        (request.auth.uid == userId && (
          (!('rank' in request.resource.data) || request.resource.data.rank == resource.data.rank) &&
          (!('email' in request.resource.data) || !('email' in resource.data) || request.resource.data.email == resource.data.email) &&
          (!('createdAt' in request.resource.data) || !('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        ))
      );

      // Only Owner and Co-Owner can delete user records, except the protected Owner profile
      allow delete: if isOwnerOrCoOwner() && !isProtectedOwnerAccount(userId);
    }

    // BOLO Reviewers: Owner, Co-Owner, Director, Management
    function canHandleBolo() {
      return isAuthenticated() && hasUserDoc() && canHandleBoloRank(getUserRank());
    }

    function isTrainingBoloCreate() {
      return request.resource.data.type == "bolo"
        && request.resource.data.trainingBolo == true
        && isJuniorAdministratorRank(getUserRank())
        && ('supervisorUid' in request.resource.data)
        && exists(/databases/$(database)/documents/users/$(request.resource.data.supervisorUid))
        && canHandleBoloRank(get(/databases/$(database)/documents/users/$(request.resource.data.supervisorUid)).data.rank);
    }

    function isNormalBoloCreate() {
      return request.resource.data.type == "bolo"
        && (!('trainingBolo' in request.resource.data) || request.resource.data.trainingBolo == false)
        && canHandleBolo();
    }

    function isBoloSubmission() {
      return request.resource.data.type == "bolo"
        && isAuthenticated();
    }

    function isBoloResolutionUpdate() {
      return canHandleBolo()
        && resource.data.type == "bolo"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'boloStatus', 'approvedBy', 'approvedAt', 'approvalReason', 'finalOutcome'
           ]);
    }

    // ==========================================
    // 2. ACTION & AUDIT LOGS COLLECTION
    // ==========================================
    match /logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.type != "bolo" ||
        isBoloSubmission() ||
        isNormalBoloCreate() ||
        isTrainingBoloCreate()
      );
      // Owner/Co-Owner retain full update and delete rights
      allow update, delete: if isOwnerOrCoOwner();
      // BOLO reviewers can update ONLY BOLO resolution fields on BOLO documents
      allow update: if isBoloResolutionUpdate();
    }

    // ==========================================
    // 3. MESSAGE PRESETS COLLECTION
    // ==========================================
    match /presets/{presetId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isManagementOrHigher();
    }

    // ==========================================
    // 4. MANAGE REASONS COLLECTION
    // ==========================================
    match /reasons/{reasonId} {
      // All authenticated staff need to read reasons for dropdown selectors
      allow read: if isAuthenticated();
      // Only Owner and Co-Owner can add, edit, or delete reason templates
      allow create, update, delete: if isOwnerOrCoOwner();
    }

    // ==========================================
    // 5. LOA REQUESTS COLLECTION
    // ==========================================
    match /loaRequests/{requestId} {
      allow read: if isAuthenticated();

      // Staff can ONLY submit requests for themselves in a pending state
      allow create: if isAuthenticated() && (
        request.resource.data.staffUid == request.auth.uid &&
        request.resource.data.status == "pending" &&
        (!('reviewerUid' in request.resource.data) || request.resource.data.reviewerUid == "") &&
        (!('reviewedBy' in request.resource.data) || request.resource.data.reviewedBy == "")
      );

      // Updates:
      // - Leadership can approve/deny and set review metadata
      // - Creators can update details ONLY while pending, and CANNOT self-approve or forge review data
      allow update: if isAuthenticated() && (
        canManageLoa() ||
        (
          resource.data.staffUid == request.auth.uid &&
          resource.data.status == "pending" &&
          request.resource.data.staffUid == resource.data.staffUid &&
          request.resource.data.status == "pending" &&
          (!('reviewerUid' in request.resource.data) || request.resource.data.reviewerUid == "") &&
          (!('reviewedBy' in request.resource.data) || request.resource.data.reviewedBy == "")
        )
      );

      // Only Owner/Co-Owner or the creator (while pending) can delete an LOA
      allow delete: if isAuthenticated() && (
        isOwnerOrCoOwner() ||
        (resource.data.staffUid == request.auth.uid && resource.data.status == "pending")
      );
    }

    // ==========================================
    // 6. NYSRP STAFF SHIFTS COLLECTION
    // ==========================================
    match /shifts/{shiftId} {
      allow read: if isAuthenticated();

      // Staff can ONLY create a shift with their own authenticated UID
      allow create: if isAuthenticated() && (
        request.resource.data.staffUid == request.auth.uid &&
        request.resource.data.status == 'active' &&
        ('endTime' in request.resource.data) &&
        request.resource.data.endTime == null
      );

      // Updates:
      // - Management+ can manage any shift record
      // - Regular staff can ONLY update their OWN shift and CANNOT tamper with immutable identity fields
      allow update: if isAuthenticated() && (
        isManagementOrHigher() ||
        (
          resource.data.staffUid == request.auth.uid &&
          request.resource.data.staffUid == resource.data.staffUid &&
          request.resource.data.staffRank == resource.data.staffRank &&
          request.resource.data.startTime == resource.data.startTime &&
          request.resource.data.createdAt == resource.data.createdAt &&
          (
            (resource.data.status == 'active' && request.resource.data.status in ['break', 'completed']) ||
            (resource.data.status == 'break' && request.resource.data.status in ['active', 'completed'])
          )
        )
      );

      // Only Owner and Co-Owner can delete shift history
      allow delete: if isOwnerOrCoOwner();
    }

    // ==========================================
    // 7. ER:LC IN-GAME PLAYERS SNAPSHOT
    // ==========================================
    match /erlc_players/{playerId} {
      allow read, write: if isAuthenticated();
      allow delete: if isOwnerOrCoOwner();
    }

    // ==========================================
    // 8. ER:LC PLAYER SESSIONS
    // ==========================================
    match /erlc_player_sessions/{sessionId} {
      allow read, write: if isAuthenticated();
      allow delete: if isOwnerOrCoOwner();
    }

    // ==========================================
    // 9. ER:LC KILLS LOGS
    // ==========================================
    match /erlc_kills/{killId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isOwnerOrCoOwner();
    }

    // ==========================================
    // 10. ER:LC COMMAND LOGS
    // ==========================================
    match /erlc_commands/{commandId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isOwnerOrCoOwner();
    }

    // ==========================================
    // 11. ER:LC SYSTEM EVENTS
    // ==========================================
    match /erlc_events/{eventId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isOwnerOrCoOwner();
    }

    // ==========================================
    // 12. ER:LC MOD CALLS
    // ==========================================
    match /erlc_mod_calls/{callId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isOwnerOrCoOwner();
    }

    // ==========================================
    // 13. ER:LC OFF-DUTY COMMAND ALERTS
    // ==========================================
    match /erlc_off_duty_commands/{alertId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isOwnerOrCoOwner();
    }
  }
}
